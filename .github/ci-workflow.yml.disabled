name: CI

# Runs on every push/PR. Until the type-error backlog is cleared, the type check
# is non-blocking (continue-on-error) so the gate stays green on real regressions only.
# Flip `continue-on-error` to false once `npx tsc --noEmit` reports 0 errors.

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci --no-audit --no-fund

      - name: Type check (non-blocking while the backlog is open)
        continue-on-error: true
        run: npx tsc --noEmit --incremental false

      - name: Unit tests
        run: npm test

      - name: Static export build
        run: npm run build:export
